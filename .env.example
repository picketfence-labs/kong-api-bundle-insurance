# Kong Konnect 接続情報のサンプル。
# このファイルを .env にコピーして値を設定してください(.env は .gitignore 済み)。

# ---- decK / Konnect API ----
# Konnect の Personal Access Token。deck sync / scripts で使用。
KONNECT_PAT=kpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# リージョン (us / eu / au)
KONNECT_REGION=us
# 反映先 Control Plane 名
CP_NAME=kong-insurance-demo

# ---- Kong Data Plane (docker compose --profile konnect) ----
# scripts/setup_konnect_dp.sh の出力を貼り付けてください。
KONNECT_CP_ENDPOINT=xxxxxxxxxx.us.cp.konghq.com:443
KONNECT_CP_SERVER_NAME=xxxxxxxxxx.us.cp.konghq.com
KONNECT_TP_ENDPOINT=xxxxxxxxxx.us.tp.konghq.com:443
KONNECT_TP_SERVER_NAME=xxxxxxxxxx.us.tp.konghq.com
