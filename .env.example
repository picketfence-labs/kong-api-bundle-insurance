# Kong Data Plane 起動用の接続情報サンプル(docker compose --profile konnect)。
# このファイルを .env にコピーして値を設定してください(.env は .gitignore 済み)。
#
# 値は Terraform の出力から取得できます:
#   cd terraform && terraform output dp_env
#
# ※ Konnect の PAT はここには書きません。Terraform 実行時に環境変数
#    TF_VAR_konnect_pat で渡してください。

KONNECT_REGION=us
CP_NAME=kong-insurance-demo

KONNECT_CP_ENDPOINT=xxxxxxxxxx.us.cp.konghq.com:443
KONNECT_CP_SERVER_NAME=xxxxxxxxxx.us.cp.konghq.com
KONNECT_TP_ENDPOINT=xxxxxxxxxx.us.tp.konghq.com:443
KONNECT_TP_SERVER_NAME=xxxxxxxxxx.us.tp.konghq.com
