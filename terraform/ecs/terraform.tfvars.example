# このファイルを terraform.tfvars にコピーして必要に応じて上書きしてください。

aws_region    = "ap-northeast-1"
project_name  = "kong-insurance"
image_tag     = "latest"
desired_count = 1

# Konnect スタックの state と、生成済み DP 証明書のパス(既定で解決されます)。
# konnect_remote_state_path = "../konnect/terraform.tfstate"
# dp_cert_path              = "../../certs/tls.crt"
# dp_key_path               = "../../certs/tls.key"
